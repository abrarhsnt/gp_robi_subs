    <worksheet name='Sheet 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Year-on-year growth, latest month</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Over the last 12 months Teletalk grew fastest in percentage terms (+3.9%), followed by Robi (+2.8%), Grameenphone (+0.8%) and Banglalink (−0.3%), the only operator that shrank. In subscribers added, Robi gained the most (+1.63M), then GP (+0.73M), then Teletalk (+0.26M), while Banglalink lost 0.10M. Teletalk’s high percentage comes from a small base of 6.9M subscribers.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gp_vs_robi_telecom' name='federated.0flc0zn16g0ef31aue2cp02enhx4' />
