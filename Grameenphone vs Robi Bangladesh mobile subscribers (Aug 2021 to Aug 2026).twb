    <worksheet name='Sheet 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Market share</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Grameenphone remains the clear leader but slipped from about 46.6% to 45.6% of all subscribers. Robi rose from about 29.3% to 30.9%. Banglalink slipped from about 20.7% to 19.9%, and Teletalk stayed around 3.5%. Shares move slowly, which shows how stable this market is. Check these figures against the chart once the monthly view is fixed.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gp_vs_robi_telecom' name='federated.0flc0zn16g0ef31aue2cp02enhx4' />
